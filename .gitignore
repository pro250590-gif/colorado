# Публикуем на GitHub Pages только сам сайт и его картинки.
# Репозиторий публичный — всё остальное сюда не выкладываем.
*
!index.html
# домен сайта: этот файл включает kolibripro.com на GitHub Pages
!CNAME
!constructor.js
# памятка и самопроверка конструктора: в истории нужна, на сайт НЕ едет —
# белый список deploy.sh берёт только constructor.js
!constructor-doc.js
!trip-colorado.js
!trip-utah.js
!trip-paris.js
!trip-paris-en.js
!trip-colorado-en.js
!trip-milan-en.js
!trip-utah-en.js
!trip-iceland-en.js
!trip-japan-en.js
!trip-usa2-en.js
!trip-test-shapes-en.js
!trip-milan.js
!trip-usa2.js
!trip-iceland.js
!trip-japan.js
!.gitignore
# база проверенных мест: номер места у Гугла + координата, на которой сошлись
# источники. Хранить это правилами разрешено бессрочно; оценок и отзывов тут нет
!places-db.json
# база аэропортов мира (OurAirports, общественное достояние): грузится только
# когда человек открывает выбор города вылета
!airports.js
# Инструменты сборки маршрута. Они не часть сайта, но должны жить вместе с ним:
# без них новый маршрут собирается «на глаз», а именно из этого росли ошибки.
!ROUTE-RULES.md
# счёт дня: одна арифметика на страницу и на проверку (иначе они расходятся)
!day-math.js
# разбор часов работы из карты — тоже общий для страницы и проверки
!open-hours.js
# собирает часы работы точек из OpenStreetMap (запускается руками, как road-times)
!hours.js
!newroute.js
!check-route.js
# страница — это движок, маршрут — это данные: ловит текст конкретной поездки,
# забытый в index.html (под Парижем висела таблица переездов Колорадо)
!check-static.js
# открывает готовую страницу в браузере без окна и читает то, что видит человек:
# чужой план, чужие даты, упавший рендер. Нужен jsdom — npm i jsdom
!check-page.js
!check-live.js
# один адрес — одна страница: главная «/», поездка «?trip», кабинет «?home».
# Ходит по сайту кнопками; иначе экраны опять начнёт решать общая память
!check-nav.js
# считает материки для шара на главной: один бит на точку вместо карты и библиотеки
!globe-mask.js
!day-order.js
!verify-coords.js
# считает километры и минуты ПО ДОРОГАМ (OpenStreetMap) и кладёт их в маршрут
!road-times.js
# ищет настоящие координаты заведений вместо кружка вокруг центра города
!food-coords.js
# набирает еду НА МАРШРУТЕ из карты вокруг точек дня
!food-nearby.js
# переносит номера мест Google (place_id) из базы в файл маршрута:
# ссылка ведёт на карточку места, а не на голую точку
!place-ids.js
# сборщик: раскладывает маршрут вокруг часов работы (правило 18в)
!fit-hours.js
# общий резак файлов маршрута (переставляет блоки, не ломая комментарии)
!edit-trip.js
# ставит точку туда, где к ней подъезжают (OSRM /nearest)
!snap-points.js
# часы работы нацпарков из справочника Службы парков США (ключ в nps-key.txt, он НЕ публикуется)
!nps-hours.js
!fetch-photos2.js
# пробный маршрут ФОРМ поездки: ночь в пути, ночёвка на выезде, поезд, перелёт
# внутри поездки. Нужен, чтобы форму можно было посмотреть живьём по ссылке
!trip-test-shapes.js
!trip-TEMPLATE.js
!img/
!img/*.webp
!img/*.jpg
!i18n.js
!CLAUDE.md
!ПЕРЕВОД.md
!i18n-scan.js
!i18n-table.js
!i18n-check.js
!i18n-extract.js
!i18n-check-trip.js
!build-langs.js
!audit-days.js
# страницы языковых версий — собираются командой node build-langs.js.
# Руками не править: правки пропадут при следующей сборке.
!en/
!en/index.html
# карта сайта и робот-файл — тоже собираются node build-langs.js из списка
# готовых языков. Руками не править
!sitemap.xml
!robots.txt
# ⚠️ ОТКЛЮЧАЕТ Jekyll НА GITHUB PAGES. Без этого файла GitHub прогоняет сайт
# через свой генератор блогов, и на нём сборка встала: страница перестала
# обновляться (проверено 06.08.2026 — правки трёх коммитов не доехали).
# Нам генератор не нужен вовсе: у нас готовые файлы, их надо просто отдать.
!.nojekyll
# скрипт выкладки на свой сервер — в репозитории он нужен нам, но НЕ посетителям:
# deploy.sh на сайт не отправляется (см. список файлов внутри самого скрипта)
!deploy.sh
