# Публикуем на GitHub Pages только сам сайт и его картинки.
# Репозиторий публичный — всё остальное сюда не выкладываем.
*
!index.html
!constructor.js
!trip-colorado.js
!trip-utah.js
!trip-paris.js
!trip-milan.js
!trip-usa2.js
!trip-iceland.js
!trip-japan.js
!.gitignore
# база проверенных мест: номер места у Гугла + координата, на которой сошлись
# источники. Хранить это правилами разрешено бессрочно; оценок и отзывов тут нет
!places-db.json
# база аэропортов мира (OurAirports, общественное достояние): грузится только
# когда человек открывает выбор города вылета
!airports.js
# Инструменты сборки маршрута. Они не часть сайта, но должны жить вместе с ним:
# без них новый маршрут собирается «на глаз», а именно из этого росли ошибки.
!ROUTE-RULES.md
!newroute.js
!check-route.js
!day-order.js
!verify-coords.js
!fetch-photos2.js
!trip-TEMPLATE.js
!img/
!img/*.webp
!img/*.jpg
